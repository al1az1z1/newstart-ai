# Copy to .env and fill in real values. Never commit the real .env file.

# --- LLM provider ---
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_PROVIDER_ENDPOINT=

# --- Artifact / results paths ---
MODEL_ARTIFACT_PATH=./artifacts/models
RAG_INDEX_PATH=./artifacts/vector_stores/routing_index
EVALUATION_RESULTS_PATH=./artifacts/reports
